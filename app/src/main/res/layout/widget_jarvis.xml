<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: tap the button to talk; tap the text to open Jarvis (today's pay opens the Earnings page) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:paddingStart="10dp" android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/w_talk" android:layout_width="56dp" android:layout_height="56dp"
        android:src="@drawable/widget_orb" android:contentDescription="Talk to Jarvis" />
    <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/w_line1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap to talk" android:textColor="#FFEAF6FF" android:textSize="17sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_line2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Or say “Hey Jarvis” any time" android:textColor="#FF9DB3C6" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
