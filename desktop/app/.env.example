# Copy this file to .env and fill it in. Never commit or share .env.
GROQ_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional
ELEVENLABS_API_KEY=
WINDY_API_KEY=
# Optional: lets Jarvis show the Google or Apple map INSIDE the screen. Without them Jarvis uses its own free worldwide map.
GOOGLE_MAPS_API_KEY=
APPLE_MAPKIT_TOKEN=
# Optional: streaming studio. OBS > Tools > WebSocket Server Settings > Enable (port 4455); the password from there:
OBS_PASSWORD=
# Optional: Discord server > Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Optional: Telegram: talk to @BotFather, /newbot, paste the token; add the bot to your group (Jarvis finds the chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
