# Copy this file to .env and fill it in. Never commit or share .env.
GROQ_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional
ELEVENLABS_API_KEY=
WINDY_API_KEY=
# Optional: lets Jarvis show the Google or Apple map INSIDE the screen. Without them Jarvis uses its own free worldwide map.
GOOGLE_MAPS_API_KEY=
APPLE_MAPKIT_TOKEN=
